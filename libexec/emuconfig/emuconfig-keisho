#!/bin/bash
# Open Keisho without a game: its game picker, with the settings overlay (F10).

if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
    export SDL_VIDEODRIVER=wayland
    export SDL_VIDEO_WAYLAND_WMCLASS="emuconfig-keisho"
else
    DISPLAY="$(getLocalXDisplay)"
    export DISPLAY
fi

exec "${RETROBOX_ROOTDIR}/bin/retrobox-launch" -system model2 -emulator keisho -rom config
