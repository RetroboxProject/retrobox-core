#!/usr/bin/env bash
# batocera-vulkan stub for standard distributions

case "$1" in
    hasVulkan)
        # Whether vulkaninfo exists and works
        if command -v vulkaninfo &>/dev/null && vulkaninfo --summary &>/dev/null 2>&1; then
            echo "true"
        else
            echo "false"
        fi
        ;;
    *)
        echo "false"
        ;;
esac
