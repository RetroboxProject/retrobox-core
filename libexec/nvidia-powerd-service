#!/usr/bin/env bash
#
# nvidia-powerd-service
#
# Controls the nvidia-powerd service through systemctl.
# Usage: nvidia-powerd-service {start|stop|status|is-active}
#
# Elevates itself with sudo when not run as root.

set -euo pipefail

SERVICE="nvidia-powerd.service"

# --- Exactly one argument ---
if [ "$#" -ne 1 ]; then
    echo "Usage: $(basename "$0") {start|stop|status|is-active}" >&2
    exit 1
fi

ACTION="$1"

# --- The action must be one of the allowed ones ---
case "$ACTION" in
start | stop | status | is-active) ;;
*)
    echo "Error: invalid action: '$ACTION'" >&2
    echo "Usage: $(basename "$0") {start|stop|status|is-active}" >&2
    exit 1
    ;;
esac

# --- status / is-active no necesitan privilegios ---
case "$ACTION" in
status | is-active) exec systemctl "$ACTION" "$SERVICE" ;;
esac

# --- start / stop ---
if [ "$EUID" -ne 0 ]; then
    # 1) Normally: the polkit rule the package installs
    #    (system/polkit/50-retrobox-nvidia-powerd.rules) allows it without a
    #    password. "--no-ask-password": never ask; the caller (the launcher)
    #    has no interactive terminal to answer.
    if systemctl --no-ask-password "$ACTION" "$SERVICE" 2>/dev/null; then
        exit 0
    fi
    # 2) Otherwise: a NOPASSWD sudoers rule written by hand for this
    #    script. "-n": without one, fail at once instead of waiting.
    exec sudo -n "$0" "$ACTION"
fi

exec systemctl "$ACTION" "$SERVICE"
