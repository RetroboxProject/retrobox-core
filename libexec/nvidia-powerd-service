#!/usr/bin/env bash
#
# nvidia-powerd-service
#
# Controla el servicio nvidia-powerd mediante systemctl.
# Uso: nvidia-powerd-service {start|stop|status|is-active}
#
# Se autoeleva con sudo si no se ejecuta como root.

set -euo pipefail

SERVICE="nvidia-powerd.service"

# --- Comprobación de número de argumentos: debe ser exactamente 1 ---
if [ "$#" -ne 1 ]; then
    echo "Uso: $(basename "$0") {start|stop|status|is-active}" >&2
    exit 1
fi

ACTION="$1"

# --- Validar que la acción sea una de las permitidas ---
case "$ACTION" in
start | stop | status | is-active) ;;
*)
    echo "Error: acción no válida: '$ACTION'" >&2
    echo "Uso: $(basename "$0") {start|stop|status|is-active}" >&2
    exit 1
    ;;
esac

# --- status / is-active no necesitan privilegios ---
case "$ACTION" in
status | is-active) exec systemctl "$ACTION" "$SERVICE" ;;
esac

# --- start / stop ---
if [ "$EUID" -ne 0 ]; then
    # 1) Normal: la regla de polkit que instala el paquete
    #    (system/polkit/50-retrobox-nvidia-powerd.rules) lo permite sin
    #    contraseña. "--no-ask-password": nunca preguntar; quien nos llama
    #    (el launcher) no tiene terminal interactivo que pueda contestar.
    if systemctl --no-ask-password "$ACTION" "$SERVICE" 2>/dev/null; then
        exit 0
    fi
    # 2) Alternativa: una regla NOPASSWD de sudoers escrita a mano para este
    #    script. "-n": si no existe, falla al instante en vez de esperar.
    exec sudo -n "$0" "$ACTION"
fi

exec systemctl "$ACTION" "$SERVICE"
