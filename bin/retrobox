#!/usr/bin/env bash
# Retrobox entrypoint: starts the frontend, or runs one maintenance action
# and exits. See usage() below, or run `retrobox --help`.
#
# The install itself is read-only: nothing is written next to this script.
set -eo pipefail

# readlink -f (not just dirname) so this also works when invoked through a
# symlink such as /usr/bin/retrobox -> /opt/retrobox/bin/retrobox.
RETROBOX_SELF="$(readlink -f "${BASH_SOURCE[0]}")"
RETROBOX_ROOTDIR="$(dirname "$(dirname "${RETROBOX_SELF}")")"
# EmulationStation finds retrobox-store (Content Downloader) through it
export RETROBOX_ROOTDIR
TOOLS_DIR="${RETROBOX_ROOTDIR}/tools"

# The Python code lives in <root>/lib (package `retrobox`).
export PYTHONPATH="${RETROBOX_ROOTDIR}/lib${PYTHONPATH:+:${PYTHONPATH}}"

# The RETROBOX_* variables the user exported himself, as opposed to the ones
# resolved below from retrobox.ini (tools/lib/paths.sh). A retrobox started
# from this one (the settings window's "Accept and open Retrobox") keeps these
# and resolves the rest again, so it sees the changes saved to retrobox.ini.
# Only the outermost retrobox sets it: by then the rest are resolved ones.
: "${RETROBOX_USER_VARS=$(compgen -e -X '!RETROBOX_*' | tr '\n' ' ' || true)}"
export RETROBOX_USER_VARS

# Interpreter: the install's own virtualenv when there is one (install.sh on
# systems where the distro packages can't be used), else the system python3.
if [[ -x "${RETROBOX_ROOTDIR}/venv/bin/python3" ]]; then
    RETROBOX_PYTHON="${RETROBOX_ROOTDIR}/venv/bin/python3"
else
    RETROBOX_PYTHON="$(command -v python3 || true)"
fi
export RETROBOX_PYTHON

# shellcheck source=tools/lib/log.sh
source "${TOOLS_DIR}/lib/log.sh"

if [[ -z "${RETROBOX_PYTHON}" ]]; then
    log_err "python3 not found. Install it with your package manager."
    exit 1
fi

# shellcheck source=tools/lib/paths.sh
source "${TOOLS_DIR}/lib/paths.sh"
# shellcheck source=tools/setup.sh
source "${TOOLS_DIR}/setup.sh"

function usage() {
    cat <<EOF
Usage: retrobox [-- FRONTEND_ARGS...]
       retrobox ACTION [NAME...]

With no action, Retrobox starts. Arguments after -- go to EmulationStation.

--console is the only way to turn on console mode: EmulationStation is a
console's only screen (no quitting it, its QUIT menu offers restart, suspend
and shut down) and its system settings offer the machine's own (time zone,
keyboard layout, language). With no --console, EmulationStation is a program
to quit, as on a desktop.

Actions (one per call; each runs and exits):
  --install-emulator [NAME...]  install or update emulators (no name: list
                                the installers and how each installs)
  --remove-emulator NAME...     uninstall emulators (their configuration
                                and saves are kept)
  --install-bezels [NAME...]    install or update bezel packs (no name: list)
  --remove-bezels NAME...       remove bezel packs
  --download [WHAT...]          download the default theme, bezels or shaders
                                again, in this terminal (no name: list)
  --settings                    open the settings window (retrobox.ini)
  --doctor [--json]             check what Retrobox needs on this computer
                                and say how to fix what is missing
  --version                     print the installed version
  -h, --help                    show this help

Emulators install as an extracted AppImage when one exists for this machine,
else as the release archive, else built from source; each installer in
tools/emulators/ also takes -a, -t or -s to choose. With the overlay
installed, a game offers to install its missing emulator by itself.
EOF
}

function retrobox_version() {
    if [[ -r "${RETROBOX_ROOTDIR}/VERSION" ]]; then
        head -n1 "${RETROBOX_ROOTDIR}/VERSION"
    elif ! git -C "${RETROBOX_ROOTDIR}" describe --tags --always --dirty 2>/dev/null; then
        echo "unknown"
    fi
}

function usage_error() {
    log_err "$1"
    echo "Run 'retrobox --help' for the options." >&2
    exit 2
}

# Run <installer flag> for each name, or list the installers when none is given.
function each_installer() {
    local kind="$1" flag="$2" action="$3"
    shift 3
    if [[ $# -eq 0 ]]; then
        list_installers "${kind}"
        return 0
    fi
    local name status=0
    for name in "$@"; do
        [[ "${name}" != -* ]] || usage_error "${action} takes names, not '${name}' (one action per call)."
    done
    for name in "$@"; do
        run_installer "${kind}" "${name}" "${flag}" || status=1
    done
    return "${status}"
}

action="${1:-}"
[[ $# -gt 0 ]] && shift

case "${action}" in
    "" | --)
        exec "${RETROBOX_PYTHON}" -m retrobox.startup "$@"
        ;;
    --console)
        if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
            usage
            exit 0
        fi
        [[ "${1:-}" == "--" ]] && shift
        exec "${RETROBOX_PYTHON}" -m retrobox.startup --console "$@"
        ;;
    --install-emulator) each_installer emulators -i "${action}" "$@" ;;
    --remove-emulator) each_installer emulators -u "${action}" "$@" ;;
    --install-bezels) each_installer decorations -i "${action}" "$@" ;;
    --remove-bezels) each_installer decorations -u "${action}" "$@" ;;
    --download)
        for name in "$@"; do
            [[ "${name}" != -* ]] || usage_error "--download takes names, not '${name}' (one action per call)."
        done
        exec "${RETROBOX_PYTHON}" -m retrobox.startup.downloads "$@"
        ;;
    --settings)
        [[ $# -eq 0 ]] || usage_error "--settings takes no arguments."
        exec "${RETROBOX_PYTHON}" -m retrobox.settingsui
        ;;
    --doctor) exec "${RETROBOX_PYTHON}" -m retrobox.doctor "$@" ;;
    --version)
        [[ $# -eq 0 ]] || usage_error "--version takes no arguments."
        retrobox_version
        ;;
    -h | --help) usage ;;
    *)
        usage_error "Unknown option '${action}'. Arguments for EmulationStation go after --."
        ;;
esac
