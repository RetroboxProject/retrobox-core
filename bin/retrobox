#!/usr/bin/env bash
# Retrobox entrypoint.
#
# On a normal launch it checks that the essentials are in place (warning,
# never stopping, if something is missing) and starts the frontend. The
# install itself is read-only: nothing is written next to this script.
#
#   retrobox --setup-emulator <name>      build a single emulator from
#                                            source (repeatable)
#   retrobox --setup-emulator             list available emulators
#   retrobox --setup-bezel <name>         install a bezel/decoration pack
#   retrobox --version                    print the installed version
#   retrobox --settings                   open the settings window (edits
#                                            ~/.config/retrobox/retrobox.ini)
#
# All of the above are maintenance operations: they run and then exit,
# they don't start the frontend afterwards. Any other argument is passed
# through to retrobox.startup (lib/retrobox/startup/run.py) untouched, which
# hands it to EmulationStation, except the --update-default-{theme,bezels,
# shaders} flags: retrobox.startup consumes them, downloads the default theme
# (es-theme-iconic) / bezels (RetroBat's) / shaders (retrobox-shaders) again
# and then starts the frontend. Syncing installed PC games (Steam, Heroic, Lutris)
# before the frontend starts is set in retrobox.ini: steam_sync, heroic_sync
# and lutris_sync under [core].
set -eo pipefail
# readlink -f (not just dirname) so this also works when invoked through a
# symlink such as /usr/bin/retrobox -> /opt/retrobox/bin/retrobox.
RETROBOX_SELF="$(readlink -f "${BASH_SOURCE[0]}")"
RETROBOX_ROOTDIR="$(dirname "$(dirname "${RETROBOX_SELF}")")"
# EmulationStation finds retrobox-store (Content Downloader) through it
export RETROBOX_ROOTDIR
TOOLS_DIR="${RETROBOX_ROOTDIR}/tools"

# The Python code lives in <root>/lib (packages `retrobox` and `gamepadly`).
export PYTHONPATH="${RETROBOX_ROOTDIR}/lib${PYTHONPATH:+:${PYTHONPATH}}"

# The RETROBOX_* variables the user exported himself, as opposed to the ones
# resolved below from retrobox.ini (tools/lib/paths.sh). A retrobox started
# from this one (the settings window's "Accept and open Retrobox") keeps these
# and resolves the rest again, so it sees the changes saved to retrobox.ini.
# Only the outermost retrobox sets it: by then the rest are resolved ones.
: "${RETROBOX_USER_VARS=$(compgen -e -X '!RETROBOX_*' | tr '\n' ' ' || true)}"
export RETROBOX_USER_VARS

# Interpreter: the install's own virtualenv when there is one (install.sh on
# systems where the distro packages can't be used), else the system python3.
if [[ -x "${RETROBOX_ROOTDIR}/venv/bin/python3" ]]; then
    RETROBOX_PYTHON="${RETROBOX_ROOTDIR}/venv/bin/python3"
else
    RETROBOX_PYTHON="$(command -v python3 || true)"
fi
export RETROBOX_PYTHON

# shellcheck source=tools/lib/paths.sh
source "${TOOLS_DIR}/lib/paths.sh"
# shellcheck source=tools/setup.sh
source "${TOOLS_DIR}/setup.sh"

function retrobox_version() {
    if [[ -r "${RETROBOX_ROOTDIR}/VERSION" ]]; then
        head -n1 "${RETROBOX_ROOTDIR}/VERSION"
    elif git -C "${RETROBOX_ROOTDIR}" describe --tags --always --dirty 2>/dev/null; then
        :
    else
        echo "unknown"
    fi
}

# Warn (never abort) about what is missing, so a half-installed system says
# so up front instead of failing deep inside the launcher.
function preflight() {
    if [[ -z "${RETROBOX_PYTHON}" ]]; then
        log_err "python3 not found. Install it with your package manager."
        exit 1
    fi
    if [[ ! -x "${RETROBOX_ES_EXECUTABLE}" ]]; then
        log_warn "EmulationStation not found at ${RETROBOX_ES_EXECUTABLE}."
        log_warn "Install the retrobox-emulationstation package."
    fi
    local missing
    missing="$("${RETROBOX_PYTHON}" -W ignore -c '
import importlib.util as u
import retrobox  # adds the bundled modules (PySDL2) to sys.path
mods = ["yaml", "evdev", "pyudev", "sdl2", "PIL", "ruamel.yaml"]
print(" ".join(m for m in mods if u.find_spec(m) is None))' 2>/dev/null || true)"
    if [[ -n "${missing}" ]]; then
        log_warn "Missing Python modules: ${missing}. Install the dependencies (see README) or re-run install.sh."
    fi
    # gamepadly is optional (gamepad hotkeys such as Hotkey+Start); check it with the very
    # interpreter the launcher will use, so a venv that can't see it is reported.
    if ! "${RETROBOX_PYTHON}" -W ignore -c 'import gamepadly' 2>/dev/null; then
        log_warn "gamepadly not importable from ${RETROBOX_PYTHON}: gamepad hotkeys are disabled."
        log_warn "Install the python3-gamepadly package (https://github.com/RetroboxProject/gamepadly)."
    fi
}

function usage() {
cat <<EOF
Usage: $(basename "${BASH_SOURCE[0]}") [OPTIONS] [-- ARGS...]
--setup-emulator <name>     Build/install a single emulator from source
                            (e.g. --setup-emulator retroarch). Can be
                            repeated to install several at once. Called
                            with no name, lists every installer available
                            under tools/emulators/.
--setup-bezel <name>        Install a single bezel/decoration pack (e.g.
                            --setup-bezel switch-online). Can be
                            repeated to install several at once. Called
                            with no name, lists every installer available
                            under tools/decorations/.
--version                   Print the installed version and exit.
--settings                  Open the settings window (folders, hidden
                            systems, PC games sync...), which edits
                            ~/.config/retrobox/retrobox.ini. Needs PySide6
                            or PyQt6.
-h, --help                  Show this help and exit.

--update-default-theme      Download the default theme (es-theme-iconic)
                            again, updating it or reinstalling it if it
                            was removed, then start the frontend. Without
                            it, the theme is only installed when there is
                            no theme at all.
--update-default-bezels     The same for the default bezels (RetroBat's).
                            Without it, they are only installed on the
                            first start.
--update-default-shaders    The same for Retrobox's shaders, which are
                            merged into the shaders folder (your own
                            shaders there are kept). Without it, they are
                            only installed on the first start.

Anything else is forwarded as-is to retrobox.startup (lib/retrobox/startup/run.py),
which in turn passes it to the frontend (EmulationStation).

Syncing installed PC games into their EmulationStation ROM directories
before the frontend starts is set in retrobox.ini, under [core]:
steam_sync, heroic_sync and lutris_sync, each one of
  none             don't sync (default)
  on-base-dir      always <data dir>/roms/<steam|heroic|lutris>
  follow-roms-dir  <roms_dir>/<steam|heroic|lutris>

The system dependencies and the udev rules are installed by the .deb/.rpm
packages or by install.sh, not by retrobox.
EOF
}

declare -a emulators_to_setup=()
declare -a bezels_to_setup=()
declare -a frontend_args=()

while [[ $# -gt 0 ]]; do
case "$1" in
--setup-emulator)
    if [[ -z "${2:-}" || "${2:0:1}" == "-" ]]; then
        list_available_emulators
        exit 0
    fi
    emulators_to_setup+=("$2")
    shift 2
    ;;
--setup-bezel)
    if [[ -z "${2:-}" || "${2:0:1}" == "-" ]]; then
        list_available_bezels
        exit 0
    fi
    bezels_to_setup+=("$2")
    shift 2
    ;;
--version)
    retrobox_version
    exit 0
    ;;
--settings)
    exec "${RETROBOX_PYTHON}" -m retrobox.settingsui
    ;;
-h | --help)
    usage
    exit 0
    ;;
--)
    shift
    frontend_args+=("$@")
    break
    ;;
*)
    frontend_args+=("$1")
    shift
    ;;
esac
done

did_maintenance=0

if [[ "${#emulators_to_setup[@]}" -gt 0 ]]; then
    status=0
    for name in "${emulators_to_setup[@]}"; do
        setup_emulator "${name}" || status=1
    done
    did_maintenance=1
    [[ "${status}" -eq 0 ]] || exit "${status}"
fi

if [[ "${#bezels_to_setup[@]}" -gt 0 ]]; then
    status=0
    for name in "${bezels_to_setup[@]}"; do
        setup_bezeles "${name}" || status=1
    done
    did_maintenance=1
    [[ "${status}" -eq 0 ]] || exit "${status}"
fi

if [[ "${did_maintenance}" -eq 1 ]]; then
    exit 0
fi

preflight

exec "${RETROBOX_PYTHON}" -m retrobox.startup "${frontend_args[@]}"
