#!/usr/bin/env bash
# retrobox-system: the system's time zone and keyboard layout, which
# EmulationStation's system settings offer in console mode (in place of
# batocera's batocera-timezone and batocera-keyboard).
#
#   retrobox-system timezone get | set ZONE
#   retrobox-system keyboard get | list-layouts | list-variants LAYOUT | set LAYOUT [VARIANT]
#
# It only picks the interpreter and sets up the import path; everything else
# is lib/retrobox/system_settings.py.
set -eo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
RETROBOX_ROOTDIR="${RETROBOX_ROOTDIR:-$(dirname "$(dirname "${SELF}")")}"
export RETROBOX_ROOTDIR
export PYTHONPATH="${RETROBOX_ROOTDIR}/lib${PYTHONPATH:+:${PYTHONPATH}}"

if [[ -z "${RETROBOX_PYTHON:-}" ]]; then
    if [[ -x "${RETROBOX_ROOTDIR}/venv/bin/python3" ]]; then
        RETROBOX_PYTHON="${RETROBOX_ROOTDIR}/venv/bin/python3"
    else
        RETROBOX_PYTHON="$(command -v python3 || true)"
    fi
fi
[[ -n "${RETROBOX_PYTHON}" ]] || { echo "retrobox-system: python3 not found" >&2; exit 1; }

exec "${RETROBOX_PYTHON}" -m retrobox.system_settings "$@"
