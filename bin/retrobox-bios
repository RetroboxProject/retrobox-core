#!/usr/bin/env bash
# retrobox-bios: list the BIOS files the systems' emulators miss, or that are
# not known dumps. EmulationStation's "Missing BIOS check" runs this, the way
# batocera's runs batocera-systems, and reads the same format; it also works
# from a terminal.
#
#   retrobox-bios [--filter SYSTEM]
#
# It only picks the interpreter and sets up the import path; everything else
# is lib/retrobox/bios.py.
set -eo pipefail
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
RETROBOX_ROOTDIR="${RETROBOX_ROOTDIR:-$(dirname "$(dirname "${SELF}")")}"
export RETROBOX_ROOTDIR
export PYTHONPATH="${RETROBOX_ROOTDIR}/lib${PYTHONPATH:+:${PYTHONPATH}}"

if [[ -z "${RETROBOX_PYTHON:-}" ]]; then
    if [[ -x "${RETROBOX_ROOTDIR}/venv/bin/python3" ]]; then
        RETROBOX_PYTHON="${RETROBOX_ROOTDIR}/venv/bin/python3"
    else
        RETROBOX_PYTHON="$(command -v python3 || true)"
    fi
fi
[[ -n "${RETROBOX_PYTHON}" ]] || { echo "retrobox-bios: python3 not found" >&2; exit 1; }

exec "${RETROBOX_PYTHON}" -m retrobox.bios "$@"
