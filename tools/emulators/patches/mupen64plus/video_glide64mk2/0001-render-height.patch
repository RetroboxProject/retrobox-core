 #include "glitchmain.h"
 #include "m64p.h"
 
+// Render height (Video-Glide64mk2 RenderHeight): the game is drawn in a
+// framebuffer object of that height (and of the window's shape), and each
+// frame is scaled to the window, which keeps the size of Video-General.
+// GL_BACK and GL_FRONT are its two colour attachments, swapped at each frame.
+static GLuint main_fbo = 0;
+static GLuint main_tex[2] = {0, 0};
+static GLuint main_depth = 0;
+static int window_width = 0, window_height = 0;
+static int render_width = 0, render_height = 0;
+
+void glitch_render_size(int win_w, int win_h, int *w, int *h)
+{
+  m64p_handle section;
+  int render_h = 0;
+  if (ConfigOpenSection("Video-Glide64mk2", &section) == M64ERR_SUCCESS)
+    render_h = ConfigGetParamInt(section, "RenderHeight");
+  *w = win_w;
+  *h = win_h;
+  if (render_h > 0 && win_h > 0 && render_h < win_h) {
+    *h = render_h;
+    *w = (win_w * render_h + win_h / 2) / win_h;
+  }
+}
+
+GLenum glitch_buffer(GLenum buffer)
+{
+  if (!main_fbo) return buffer;
+  if (buffer == GL_BACK) return GL_COLOR_ATTACHMENT0_EXT;
+  if (buffer == GL_FRONT) return GL_COLOR_ATTACHMENT1_EXT;
+  return buffer;
+}
+
+static void attach_main_textures()
+{
+  glFramebufferTexture2DEXT(GL_FRAMEBUFFER_EXT, GL_COLOR_ATTACHMENT0_EXT, GL_TEXTURE_2D, main_tex[0], 0);
+  glFramebufferTexture2DEXT(GL_FRAMEBUFFER_EXT, GL_COLOR_ATTACHMENT1_EXT, GL_TEXTURE_2D, main_tex[1], 0);
+}
+
+static void create_main_fbo(int w, int h)
+{
+  render_width = w;
+  render_height = h;
+  glGenFramebuffersEXT(1, &main_fbo);
+  glBindFramebufferEXT(GL_FRAMEBUFFER_EXT, main_fbo);
+  for (int i = 0; i < 2; i++) {
+    glBindTexture(GL_TEXTURE_2D, main_tex[i]);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGB8, w, h, 0, GL_RGB, GL_UNSIGNED_BYTE, NULL);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+  }
+  glBindTexture(GL_TEXTURE_2D, 0);
+  attach_main_textures();
+  glGenRenderbuffersEXT(1, &main_depth);
+  glBindRenderbufferEXT(GL_RENDERBUFFER_EXT, main_depth);
+  glRenderbufferStorageEXT(GL_RENDERBUFFER_EXT, GL_DEPTH_COMPONENT24, w, h);
+  glFramebufferRenderbufferEXT(GL_FRAMEBUFFER_EXT, GL_DEPTH_ATTACHMENT_EXT, GL_RENDERBUFFER_EXT, main_depth);
+  glBindRenderbufferEXT(GL_RENDERBUFFER_EXT, 0);
+  if (glCheckFramebufferStatusEXT(GL_FRAMEBUFFER_EXT) != GL_FRAMEBUFFER_COMPLETE_EXT) {
+    printf("(EE) Glide64mk2: no %dx%d framebuffer, rendering at the window's size\n", w, h);
+    glBindFramebufferEXT(GL_FRAMEBUFFER_EXT, 0);
+    glDeleteFramebuffersEXT(1, &main_fbo);
+    glDeleteRenderbuffersEXT(1, &main_depth);
+    main_fbo = main_depth = 0;
+    return;
+  }
+  glDrawBuffer(GL_COLOR_ATTACHMENT0_EXT);
+  glReadBuffer(GL_COLOR_ATTACHMENT0_EXT);
+  glClearColor(0, 0, 0, 1);
+  glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT);
+  printf("(II) Glide64mk2: rendering at %dx%d, scaled to %dx%d\n", w, h, window_width, window_height);
+}
+
+static void destroy_main_fbo()
+{
+  if (!main_fbo) return;
+  glBindFramebufferEXT(GL_FRAMEBUFFER_EXT, 0);
+  glDeleteFramebuffersEXT(1, &main_fbo);
+  glDeleteRenderbuffersEXT(1, &main_depth);
+  glDeleteTextures(2, main_tex);
+  main_fbo = main_depth = 0;
+}
+
+// The frame, scaled to the window's back buffer.
+static void present_main_fbo()
+{
+  glPushAttrib(GL_SCISSOR_BIT | GL_COLOR_BUFFER_BIT);
+  glDisable(GL_SCISSOR_TEST);
+  glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+  glBindFramebufferEXT(GL_READ_FRAMEBUFFER_EXT, main_fbo);
+  glReadBuffer(GL_COLOR_ATTACHMENT0_EXT);
+  glBindFramebufferEXT(GL_DRAW_FRAMEBUFFER_EXT, 0);
+  glDrawBuffer(GL_BACK);
+  glBlitFramebufferEXT(0, 0, render_width, render_height, 0, 0, window_width, window_height,
+    GL_COLOR_BUFFER_BIT, GL_LINEAR);
+  glPopAttrib();
+}
+
+// After the swap: the frame just shown is the front buffer, the other one
+// is drawn next.
+static void flip_main_fbo()
+{
+  GLuint shown = main_tex[0];
+  main_tex[0] = main_tex[1];
+  main_tex[1] = shown;
+  glBindFramebufferEXT(GL_FRAMEBUFFER_EXT, main_fbo);
+  attach_main_textures();
+}
+
