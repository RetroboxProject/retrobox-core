   // depth_bias = -Config_ReadInt ("depth_bias", "Depth bias level", 0, TRUE, FALSE);
   settings.res_data = 0;
   Config_ReadInt("RenderHeight", "Height the game is drawn at, scaled to the window (0: the window's)", 0, TRUE, FALSE);
+  Config_ReadInt("OverscanHorizontal", "Pixels of the picture cropped on the left and on the right, 0 to 20", 0, TRUE, FALSE);
+  Config_ReadInt("OverscanVertical", "Pixels of the picture cropped on the top and on the bottom, 0 to 20", 0, TRUE, FALSE);
