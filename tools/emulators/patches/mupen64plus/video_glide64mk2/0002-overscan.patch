 static void (*l_DebugCallback)(void *, int, const char *) = NULL;
 static void *l_DebugCallContext = NULL;
 
+// Overscan (Video-Glide64mk2 OverscanHorizontal and OverscanVertical): the pixels of
+// the N64's picture that are cropped at each side, so that what is left of it fills its
+// place on the screen. Glitch64 does it when it presents the frame.
+void glitch_overscan_pixels(int *horizontal, int *vertical);
+void glitch_set_overscan(float x0, float y0, float x1, float y1, float dx, float dy);
+
+static void UpdateOverscan ()
+{
+  int pixels_x, pixels_y;
+  // the picture's place, in the pixels of the screen it is drawn at (from the top left)
+  float x0 = rdp.offset_x;
+  float x1 = (float)settings.res_x;
+  float y0 = (float)settings.scr_res_y - (float)settings.res_y;
+  float y1 = (float)settings.res_y;
+  float dx = 0.0f, dy = 0.0f;
+  glitch_overscan_pixels(&pixels_x, &pixels_y);
+  // the original size has no place to scale the picture to
+  if (settings.aspectmode != 3)
+  {
+    // the pixels are the N64's, whatever the size the picture is drawn at
+    if (rdp.vi_width > 2.0f * pixels_x)
+      dx = (x1 - x0) * pixels_x / rdp.vi_width;
+    if (rdp.vi_height > 2.0f * pixels_y)
+      dy = (y1 - y0) * pixels_y / rdp.vi_height;
+  }
+  glitch_set_overscan (x0, y0, x1, y1, dx, dy);
+}
+
 void _ChangeSize ()
 {
   rdp.scale_1024 = settings.scr_res_x / 1024.0f;
@@ -310,6 +338,7 @@ void ChangeSize ()
   }
   //	settings.res_x = settings.scr_res_x;
   //	settings.res_y = settings.scr_res_y;
+  UpdateOverscan ();
 }
 
