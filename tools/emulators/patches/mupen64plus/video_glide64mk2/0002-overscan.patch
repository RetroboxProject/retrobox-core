+// Overscan (Video-Glide64mk2 OverscanHorizontal, OverscanVertical): the picture's
+// place in the render size's pixels (top-down) and the part of each of its sides
+// that is cropped, set by the plugin each time the picture changes its size.
+static float overscan_pic[4] = {0, 0, 0, 0};
+static float overscan_dx = 0, overscan_dy = 0;
+
+// The most pixels of the N64's picture that can be cropped on each side.
+#define MAX_OVERSCAN 20
+
+static int overscan_option(m64p_handle section, const char *name)
+{
+  int pixels = ConfigGetParamInt(section, name);
+  return pixels < 0 ? 0 : (pixels > MAX_OVERSCAN ? MAX_OVERSCAN : pixels);
+}
+
+// Whether an overscan is set: it needs the framebuffer object, as RenderHeight does.
+int glitch_overscan_wanted()
+{
+  m64p_handle section;
+  if (ConfigOpenSection("Video-Glide64mk2", &section) != M64ERR_SUCCESS)
+    return 0;
+  return overscan_option(section, "OverscanHorizontal") > 0 ||
+         overscan_option(section, "OverscanVertical") > 0;
+}
+
+// The pixels of overscan to crop on each side, as OverscanHorizontal and
+// OverscanVertical set them (0 to 20 pixels of the N64's picture).
+void glitch_overscan_pixels(int *horizontal, int *vertical)
+{
+  m64p_handle section;
+  *horizontal = *vertical = 0;
+  if (ConfigOpenSection("Video-Glide64mk2", &section) != M64ERR_SUCCESS)
+    return;
+  *horizontal = overscan_option(section, "OverscanHorizontal");
+  *vertical = overscan_option(section, "OverscanVertical");
+}
+
+// The picture is the (x0, y0)-(x1, y1) rectangle of the render size's pixels,
+// measured from the top left; dx and dy are the pixels to crop from each side.
+void glitch_set_overscan(float x0, float y0, float x1, float y1, float dx, float dy)
+{
+  overscan_pic[0] = x0;
+  overscan_pic[1] = y0;
+  overscan_pic[2] = x1;
+  overscan_pic[3] = y1;
+  overscan_dx = dx;
+  overscan_dy = dy;
+}
+
 GLenum glitch_buffer(GLenum buffer)
 {
   if (!main_fbo) return buffer;
@@ -121,9 +170,41 @@ static void destroy_main_fbo()
   main_fbo = main_depth = 0;
 }
 
-// The frame, scaled to the window's back buffer.
+static int clamp_int(int value, int low, int high)
+{
+  return value < low ? low : (value > high ? high : value);
+}
+
+// The frame, scaled to the window's back buffer. With an overscan only the
+// picture is drawn, without the pixels cropped from its sides (the window
+// outside of it is cleared).
 static void present_main_fbo()
 {
+  int src_x0 = 0, src_y0 = 0, src_x1 = render_width, src_y1 = render_height;
+  int dst_x0 = 0, dst_y0 = 0, dst_x1 = window_width, dst_y1 = window_height;
+  int cropped = overscan_dx > 0 || overscan_dy > 0;
+  if (cropped) {
+    // the rectangles measure from the top, and OpenGL from the bottom
+    float scale_x = (float)window_width / render_width;
+    float scale_y = (float)window_height / render_height;
+    src_x0 = clamp_int((int)(overscan_pic[0] + overscan_dx + 0.5f), 0, render_width);
+    src_x1 = clamp_int((int)(overscan_pic[2] - overscan_dx + 0.5f), 0, render_width);
+    src_y0 = render_height - clamp_int((int)(overscan_pic[3] - overscan_dy + 0.5f), 0, render_height);
+    src_y1 = render_height - clamp_int((int)(overscan_pic[1] + overscan_dy + 0.5f), 0, render_height);
+    dst_x0 = clamp_int((int)(overscan_pic[0] * scale_x + 0.5f), 0, window_width);
+    dst_x1 = clamp_int((int)(overscan_pic[2] * scale_x + 0.5f), 0, window_width);
+    dst_y0 = window_height - clamp_int((int)(overscan_pic[3] * scale_y + 0.5f), 0, window_height);
+    dst_y1 = window_height - clamp_int((int)(overscan_pic[1] * scale_y + 0.5f), 0, window_height);
+    cropped = src_x1 > src_x0 && src_y1 > src_y0 && dst_x1 > dst_x0 && dst_y1 > dst_y0;
+    if (!cropped) {
+      // a picture that cannot be cropped is shown whole
+      src_x0 = src_y0 = dst_x0 = dst_y0 = 0;
+      src_x1 = render_width;
+      src_y1 = render_height;
+      dst_x1 = window_width;
+      dst_y1 = window_height;
+    }
+  }
   glPushAttrib(GL_SCISSOR_BIT | GL_COLOR_BUFFER_BIT);
   glDisable(GL_SCISSOR_TEST);
   glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
@@ -131,7 +212,11 @@ static void present_main_fbo()
   glReadBuffer(GL_COLOR_ATTACHMENT0_EXT);
   glBindFramebufferEXT(GL_DRAW_FRAMEBUFFER_EXT, 0);
   glDrawBuffer(GL_BACK);
-  glBlitFramebufferEXT(0, 0, render_width, render_height, 0, 0, window_width, window_height,
+  if (cropped && (dst_x0 > 0 || dst_y0 > 0 || dst_x1 < window_width || dst_y1 < window_height)) {
+    glClearColor(0, 0, 0, 1);
+    glClear(GL_COLOR_BUFFER_BIT);
+  }
+  glBlitFramebufferEXT(src_x0, src_y0, src_x1, src_y1, dst_x0, dst_y0, dst_x1, dst_y1,
     GL_COLOR_BUFFER_BIT, GL_LINEAR);
   glPopAttrib();
 }
