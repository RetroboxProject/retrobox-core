# Runtime dependencies for Debian, Ubuntu and derivatives (apt package names).
# Single source: the .deb's Depends is built
# from them and install.sh uses them. One package per line; "a | b" = either.
python3
python3-yaml
python3-pyudev
python3-sdl2
python3-pil
python3-qrcode
python3-evdev
python3-ruamel.yaml
python3-tomlkit
python3-requests
python3-typing-extensions
python3-venv
libfreeimage3
libsdl2-2.0-0
libsdl2-mixer-2.0-0
libvlc5
libice6
libsm6
libxtst6
libxi6
libnotify-bin
inotify-tools
unzip
wget
zstd
7zip | p7zip-full
# retrobox-screenshot: scrot on X11 sessions, grim on Wayland ones
scrot
grim
# retrobox-emukill asks the game's windows to close before it signals: wmctrl on X11 sessions (wlrctl on Wayland ones, where it is optional)
wmctrl

# mesa-utils and vulkan-tools for gpu api detection on emulators
mesa-utils
vulkan-tools
