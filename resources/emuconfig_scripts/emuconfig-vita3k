#!/bin/bash

if [ -n "$WAYLAND_DISPLAY" ]; then
    export SDL_VIDEODRIVER=wayland
    export SDL_VIDEO_WAYLAND_WMCLASS="emuconfig-vita3k"
else
    export DISPLAY=$(getLocalXDisplay)
fi

# set the environment variables
CFGDIR="${RETROBOX_EMUCONFIG_DIR}/vita3k"
XDG_CONFIG_HOME=$CFGDIR \
XDG_CACHE_HOME="${HOME}/.cache" \
XDG_DATA_HOME="${RETROBOX_SAVES_DIR}" \
XDG_DATA_DIRS="${RETROBOX_SAVES_DIR}" \
# now run the emulator
/usr/bin/vita3k/Vita3K
