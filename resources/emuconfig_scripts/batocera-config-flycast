#!/bin/bash

if [ -n "$WAYLAND_DISPLAY" ]; then
    export SDL_VIDEODRIVER=wayland
    export SDL_VIDEO_WAYLAND_WMCLASS="batocera-config-flycast"
else
    export DISPLAY=$(getLocalXDisplay)
fi

export XDG_CONFIG_HOME="${RETROBOX_EMUCONFIG_DIR}/flycast"
export XDG_CONFIG_DIRS="${RETROBOX_EMUCONFIG_DIR}/flycast"
export XDG_DATA_HOME="${RETROBOX_SAVES_DIR}/dreamcast"
export FLYCAST_DATADIR="${RETROBOX_SAVES_DIR}/dreamcast"
export FLYCAST_BIOS_PATH="${RETROBOX_BIOS_DIR}"

/usr/local/bin/flycast
