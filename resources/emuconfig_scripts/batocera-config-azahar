#!/bin/bash

# when the program is called from a non X environment, handle the mouse
# maybe an other choice is better

if test -z "${DISPLAY}"
then
    export DISPLAY=$(getLocalXDisplay)
fi

XDG_CONFIG_HOME="${RETROBOX_EMUCONFIG_DIR}/azahar" \
XDG_DATA_HOME="${RETROBOX_SAVES_DIR}/3ds" \
XDG_CACHE_HOME="${HOME}/.cache" \
SDL_JOYSTICK_HIDAPI=0 \
/usr/local/bin/azahar
