#!/bin/sh
set -e

case "$1" in
    configure)
        # Byte-compile the runtime: the install tree is read-only for users,
        # so Python could never cache it on its own and every game launch
        # would re-parse ~250 modules. py3clean (prerm) removes these again.
        if command -v py3compile >/dev/null 2>&1; then
            py3compile -p retrobox-core /opt/retrobox/lib || true
        fi

        if command -v udevadm >/dev/null 2>&1; then
            udevadm control --reload-rules >/dev/null 2>&1 || true
            udevadm trigger --subsystem-match=input --subsystem-match=hidraw \
                --action=change >/dev/null 2>&1 || true
        fi
        ;;
esac

exit 0
