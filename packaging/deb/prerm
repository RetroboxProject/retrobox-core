#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Remove the .pyc files created by postinst, otherwise dpkg can't
        # delete /opt/retrobox/lib (it doesn't know about them).
        if command -v py3clean >/dev/null 2>&1; then
            py3clean -p retrobox-core || true
        fi
        ;;
esac

exit 0
